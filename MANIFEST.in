# The sdist carries the literate sources and the backend that builds them —
# that IS the source distribution. The generated servette.py is included too
# (fresh: the backend regenerates it during build_sdist), so an sdist reader
# sees the module without running anything.
graft src
# The build reads the mark from here to inline it as the pages' favicon, so
# an sdist without it cannot build.
include assets/servette-mark.svg
# The backend's own import writes src/__pycache__/*.pyc during every sdist
# build, and `graft src` would ship them; this line alone keeps them out.
recursive-exclude src *.pyc

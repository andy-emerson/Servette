# Python
*.pyc
__pycache__/

# Packaging build artifacts
*.egg-info/
build/
dist/

# Local virtualenvs
.venv/

# Runtime config — contains password hashes and cert paths
servette.toml

# The publish lock's file — held via flock, content-free, created at first use
.publish.lock

# SSL certificates and keys
*.pem

# Throwaway certs and keys named for a .test domain (RFC 2606), which a
# probe script once left in the repository root and a blind stage committed
*.test

# Site folders the suite creates through the page's add-site door
site-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*/

# Log files
*.log

# macOS
.DS_Store
